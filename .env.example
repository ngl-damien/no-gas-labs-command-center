# No_Gas_Labs Command Center local development
NODE_ENV=development

# Upstream services called by the Express API
NODE_GATE_URL=http://127.0.0.1:3001
EVIDENCEOS_URL=http://127.0.0.1:3002

# Local Command Center API (Vite proxies /api/* here)
COMMAND_CENTER_PORT=3003
COMMAND_CENTER_API_URL=http://127.0.0.1:3003

# Production server port for pnpm start; dev runner derives PORT from COMMAND_CENTER_PORT
PORT=
